<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.suke.czx.modules.warehouse.inbound.infrastructure.repository.InboundOrderMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.suke.czx.modules.warehouse.inbound.domain.entity.InboundOrder">
        <id column="order_id" property="orderId"/>
        <result column="batch_no" property="batchNo"/>
        <result column="supplier_id" property="supplierId"/>
        <result column="total_quantity" property="totalQuantity"/>
        <result column="total_cost" property="totalCost"/>
        <result column="status" property="status"/>
        <result column="operator_id" property="operatorId"/>
        <result column="remark" property="remark"/>
        <result column="tenancy_id" property="tenancyId"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 根据批次号查询入库单列表 -->
    <select id="selectByBatchNo" resultMap="BaseResultMap">
        SELECT *
        FROM wms_inbound_order
        WHERE batch_no = #{batchNo}
        ORDER BY create_time DESC
    </select>

</mapper>
