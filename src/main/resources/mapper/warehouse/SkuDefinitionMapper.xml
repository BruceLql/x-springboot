<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.suke.czx.modules.warehouse.combination.infrastructure.repository.SkuDefinitionMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.suke.czx.modules.warehouse.combination.domain.entity.SkuDefinition">
        <id column="sku_id" property="skuId"/>
        <result column="sku_name" property="skuName"/>
        <result column="sku_image" property="skuImage"/>
        <result column="pre_allocate_quantity" property="preAllocateQuantity"/>
        <result column="status" property="status"/>
        <result column="goods_ids" property="goodsIds"/>
        <result column="operator_id" property="operatorId"/>
        <result column="tenancy_id" property="tenancyId"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 根据状态查询SKU列表 -->
    <select id="selectByStatus" resultMap="BaseResultMap">
        SELECT *
        FROM wms_sku_definition
        WHERE status = #{status}
        ORDER BY create_time DESC
    </select>

</mapper>
