<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.suke.czx.modules.warehouse.supplier.infrastructure.repository.SupplierGoodsRelMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.suke.czx.modules.warehouse.supplier.domain.entity.SupplierGoodsRel">
        <id column="id" property="id"/>
        <result column="supplier_id" property="supplierId"/>
        <result column="goods_id" property="goodsId"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 根据供应商ID查询关联记录 -->
    <select id="selectBySupplierId" resultMap="BaseResultMap">
        SELECT *
        FROM wms_supplier_goods_rel
        WHERE supplier_id = #{supplierId}
    </select>

    <!-- 根据货物ID查询关联记录 -->
    <select id="selectByGoodsId" resultMap="BaseResultMap">
        SELECT *
        FROM wms_supplier_goods_rel
        WHERE goods_id = #{goodsId}
    </select>

    <!-- 批量插入关联关系 -->
    <insert id="batchInsert">
        INSERT INTO wms_supplier_goods_rel (supplier_id, goods_id, create_time, update_time)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.supplierId}, #{item.goodsId}, NOW(), NOW())
        </foreach>
    </insert>

    <!-- 根据供应商ID删除所有关联 -->
    <delete id="deleteBySupplierId">
        DELETE FROM wms_supplier_goods_rel
        WHERE supplier_id = #{supplierId}
    </delete>

    <!-- 根据供应商ID和货物ID删除关联 -->
    <delete id="deleteBySupplierIdAndGoodsId">
        DELETE FROM wms_supplier_goods_rel
        WHERE supplier_id = #{supplierId} AND goods_id = #{goodsId}
    </delete>

</mapper>
