<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.suke.czx.modules.warehouse.supplier.infrastructure.repository.SupplierMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.suke.czx.modules.warehouse.supplier.domain.entity.Supplier">
        <id column="supplier_id" property="supplierId"/>
        <result column="supplier_name" property="supplierName"/>
        <result column="address" property="address"/>
        <result column="contact_phone" property="contactPhone"/>
        <result column="supplier_type" property="supplierType"/>
        <result column="status" property="status"/>
        <result column="tenancy_id" property="tenancyId"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 查询启用的供应商列表 -->
    <select id="selectActiveSuppliers" resultMap="BaseResultMap">
        SELECT *
        FROM wms_supplier
        WHERE status = 1
        ORDER BY create_time DESC
    </select>

    <!-- 根据货物ID查询关联的供应商列表 -->
    <select id="selectByGoodsId" resultMap="BaseResultMap">
        SELECT s.*
        FROM wms_supplier s
        INNER JOIN wms_supplier_goods_rel sgr ON s.supplier_id = sgr.supplier_id
        WHERE sgr.goods_id = #{goodsId}
          AND s.status = 1
        ORDER BY s.create_time DESC
    </select>

</mapper>
